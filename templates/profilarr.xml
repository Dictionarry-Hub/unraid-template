<Container version="2">
  <Name>Profilarr</Name>
  <Repository>ghcr.io/dictionarry-hub/profilarr:latest</Repository>
  <Registry>https://github.com/Dictionarry-Hub/profilarr</Registry>
  <Network>bridge</Network>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <WebUI>http://[IP]:[PORT:6868]</WebUI>
  <Overview>Configuration management tool for Radarr/Sonarr that automates importing and version control of custom formats and quality profiles.</Overview>
  <Support>https://github.com/Dictionarry-Hub/profilarr/issues</Support>
  <Project>https://github.com/Dictionarry-Hub/profilarr</Project>
  <ReadMe>https://dictionarry.dev</ReadMe>
  <Discord>https://discord.gg/qv4H7n8nss</Discord>
  <Category>Productivity: Tools: MediaApp:Video MediaServer:Video</Category>
  <Icon>https://raw.githubusercontent.com/Dictionarry-Hub/profilarr/b7406d96d5da7cc45e821b2ab270308bf0c37326/src/lib/client/assets/logo-512.png</Icon>
  <TemplateURL>https://raw.githubusercontent.com/Dictionarry-Hub/unraid-template/main/templates/profilarr.xml</TemplateURL>
  <Config Name="WebUI" Target="6868" Default="6868" Mode="tcp" Description="" Type="Port" Display="always" Required="true" Mask="false"/>
  <Config Name="Config" Target="/config" Default="" Mode="rw" Description="" Type="Path" Display="always" Required="true" Mask="false"/>
  <Config Name="PUID" Target="PUID" Default="" Mode="" Description="" Type="Variable" Display="advanced" Required="false" Mask="false">99</Config>
  <Config Name="PGID" Target="PGID" Default="" Mode="" Description="" Type="Variable" Display="advanced" Required="false" Mask="false">100</Config>
  <Config Name="UMASK" Target="UMASK" Default="" Mode="" Description="" Type="Variable" Display="advanced" Required="false" Mask="false">022</Config>
</Container>
